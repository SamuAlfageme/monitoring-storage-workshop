# Copy to registry-credentials.env (gitignored) and fill in for private registries.
# Used by: make create-pull-secret
#
#   cp fault-injector/k8s/registry-credentials.env.example fault-injector/k8s/registry-credentials.env
#   make create-pull-secret
#   make deploy-remote IMAGE_PULL_SECRET=fault-injector-pull ...

REGISTRY_SERVER=ghcr.io
REGISTRY_USER=your-github-username
REGISTRY_PASSWORD=ghp_your_token_or_password
REGISTRY_EMAIL=you@example.com
